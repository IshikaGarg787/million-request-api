# Copy this file to ".env" and change what you need. Every line is optional.
#   Windows PowerShell:  copy .env.example .env
#   Mac / Linux:         cp .env.example .env

# Port the API listens on
PORT=3000

# How many worker processes to start. Leave empty = one per CPU core.
# WORKERS=4

# Where users are stored:
#   memory = no database needed, data is lost when the server stops (good for trying it out)
#   mongo  = MongoDB, data is saved and shared by all workers / servers
STORAGE=memory

# Only used when STORAGE=mongo
MONGO_URI=mongodb://127.0.0.1:27017/million_requests_api
MONGO_POOL_SIZE=20

# Rate limit: max requests per IP address per window. 0 = no limit.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_SECONDS=60

# Largest request body accepted
BODY_LIMIT=10kb

# Print one line per request (useful while learning, slows the server under load)
LOG_REQUESTS=false

# Set to 1 when the API runs behind nginx / a load balancer
# TRUST_PROXY=1

# How long to wait for running requests to finish when stopping (milliseconds)
SHUTDOWN_TIMEOUT_MS=10000
